rules_version = '2';

// 客戶經營名單｜Firestore 權限規則
// ─────────────────────────────────────────────
// admins/{uid}                 管理員名單（role: owner 擁有者／admin 一般管理員）
// users/{uid}                  業務帳號資料（status: pending 待開通 / active 已開通 / disabled 已停用）
// users/{uid}/clients/{cid}    該業務的客戶名單
// users/{uid}.managerUid       直屬主管；users/{uid}.managers 整條上線鏈（由管理員在後台指派）
//
// 原則：
// 1. 業務只能讀寫「自己」的帳號資料與名單，看不到其他業務。
// 2. 新註冊的帳號一律是「待開通」，必須由管理員在後台開通後才能建立名單。
// 3. 管理員可以讀取所有業務的帳號與名單，並可開通／停用帳號；但不能代替業務修改名單內容。
// 4. 帳號被停用後，業務無法再讀寫名單，但名單仍保留給管理員檢視。
// 5. 主管（上線鏈中的任何一層）可唯讀自己所有下線的帳號資料與名單；平行主管之間互相看不到。

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isActive(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'active';
    }
    function ownEmail() {
      return request.resource.data.email == request.auth.token.email;
    }
    // 目前登入者是否為該業務的上線主管（任何一層）
    function managesUser(uid) {
      return signedIn() && isActive(request.auth.uid)
        && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('managers', []);
    }
    // 業務本人不能修改自己的組織關係
    function orgUnchanged() {
      return request.resource.data.get('managers', []) == resource.data.get('managers', [])
        && request.resource.data.get('managerUid', null) == resource.data.get('managerUid', null);
    }

    // 管理員名單：管理員可在後台新增／移除「一般管理員」；擁有者（role: owner）只能在主控台調整
    match /admins/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isAdmin() && request.resource.data.role == 'admin';
      allow delete: if isAdmin() && resource.data.role == 'admin';
      allow update: if false;
    }

    // 業務帳號資料
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin()
        || (signedIn() && isActive(request.auth.uid) && request.auth.uid in resource.data.managers);

      // 首次登入建立帳號：只能建立自己的，狀態必須是待開通，且不能自帶組織關係
      allow create: if isSelf(uid)
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['managers', 'managerUid'])
        && ownEmail();

      // 本人可更新姓名等資料，但不能改自己的開通狀態；管理員可更新任何人的狀態
      allow update: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.status == resource.data.status
            && orgUnchanged()
            && ownEmail());

      allow delete: if isAdmin();

      // 客戶名單：本人且已開通才能讀寫；管理員與上線主管唯讀
      match /clients/{cid} {
        allow read: if isAdmin() || (isSelf(uid) && isActive(uid)) || managesUser(uid);
        allow create, update: if isSelf(uid) && isActive(uid)
          && request.resource.data.ownerUid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0;
        allow delete: if isSelf(uid) && isActive(uid);
      }
    }

    // 管理員後台一次讀取全團隊名單（collection group 查詢）
    match /{path=**}/clients/{cid} {
      allow read: if isAdmin();
    }
  }
}
